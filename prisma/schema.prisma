generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Language {
  HI
  EN
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  news News[]

  @@index([slug])
}

model News {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  description     String?
  content         String?
  imageUrl        String?
  sourceName      String?
  sourceUrl       String?
  externalId      String
  authorName      String?
  sponsorName     String?
  sponsorUrl      String?
  language        Language   @default(HI)
  status          NewsStatus @default(DRAFT)
  isFeatured      Boolean    @default(false)
  isBreaking      Boolean    @default(false)
  isOriginal      Boolean    @default(false)
  isSponsored     Boolean    @default(false)
  viewCount       Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([externalId])
  @@index([categoryId])
  @@index([language])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([isBreaking])
  @@index([isOriginal])
  @@index([isSponsored])
  @@index([viewCount])
}

model SiteSettings {
  id              String   @id @default("default")
  siteName        String   @default("Hindi News")
  siteDescription String?
  logoUrl         String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  websiteUrl      String?
  facebookUrl     String?
  instagramUrl    String?
  youtubeUrl      String?
  breakingEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
